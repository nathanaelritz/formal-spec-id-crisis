(*
This work is a unique adaptation 
and extension, developed apart from the original
academic model released under the Apache 2.0 license: 

https://github.com/CCC-Attestation/formal-spec-id-crisis/tree/main

Original TLS 1.3 library model produced by Bhargavan et al. is available
at: https://github.com/Inria-Prosecco/reftls/blob/master/pv/tls-lib.pvl
*)

(*
   Step-wise correspondence proof of relay attacks on intra-handshake
   attestation with pubEK binding (Mechanism #4).
   Model: tls-lib-simple.pvl

   NOTE: The protocol modeled here is SECURE against intra-handshake 
   relay attacks. Thanks to the RFC 9345 Delegated Credentials (DC) 
   design, the rdata_nonce explicitly binds to the handshake transcript 
   (log_SH). This transcript includes the KEM shares and the server identity.
   
   Because of this tight binding, the phase-structured queries (Part C) 
   evaluate to TRUE (unless specific keys like AK are leaked). Furthermore, 
   a KEM compromise (BadCiphertext) alone is insufficient to break the 
   protocol, because the attacker still cannot forge the CertificateVerify 
   signature without the ephemeral signing key (privEK). Therefore, removing 
   the BadCiphertext escapes (in the "variant" queries) does not cause the 
   properties to fail.

   PAIRED VARIANTS: Each query appears twice. The first instance is the
   original. The second instance has event(ServerChoosesKEX(...BadCiphertext))
   and event(SentBrokenKEMSecret) removed from the disjunction. Queries
   without those escapes are reproduced as-is in both positions.
*)

(* ================================================================== *)
(* PART A: KEM IDENTITY                                                *)
(* The relay operates at the KEM layer before attestation is involved. *)
(* ================================================================== *)

(* A1 — EXPECTED FALSE *)
query ID_S: identity, kem_ss: bitstring;
inj-event(ClientID(ID_S, kem_ss))
    ==> inj-event(ServerID(ID_S, kem_ss))
.

(* ================================================================== *)
(* PART B: BINDING LEVEL ANALYSIS                                     *)
(* ================================================================== *)

(* B1 non-injective bare — EXPECTED FALSE *)
query log: bitstring;
event(Appraised(log))
    ==> event(Conveyed(log))
.

(* B1 variant — EXPECTED FALSE *)
query log: bitstring;
event(Appraised(log))
    ==> event(Conveyed(log))
.

(* B2 injective bare — EXPECTED FALSE *)
query log: bitstring;
inj-event(Appraised(log))
    ==> inj-event(Conveyed(log))
.

(* B2 variant — EXPECTED FALSE *)
query log: bitstring;
inj-event(Appraised(log))
    ==> inj-event(Conveyed(log))
.

(* B3 injective + all escapes — EXPECTED TRUE *)
query log: bitstring, pubAK: pubkey, pubEK: pubkey, cr': random, sr': random;
inj-event(Appraised(log))
    ==> inj-event(Conveyed(log))
     || event(ServerChoosesKEX(cr', sr', KEM_13(BadCiphertext)))
     || event(ServerChoosesHash(cr', sr', WeakHash))
     || event(SentBrokenKEMSecret)
     || event(LeakedAK(pubAK))
     || event(LeakedEK(pubEK))
.

(* B3 variant — EXPECTED TRUE *)
query log: bitstring, pubAK: pubkey, pubEK: pubkey, cr': random, sr': random;
inj-event(Appraised(log))
    ==> inj-event(Conveyed(log))
     || event(ServerChoosesHash(cr', sr', WeakHash))
     || event(LeakedAK(pubAK))
     || event(LeakedEK(pubEK))
.

(* B4 injective + LeakedEK only — EXPECTED FALSE *)
query log: bitstring, pubEK: pubkey, cr': random, sr': random;
inj-event(Appraised(log))
    ==> inj-event(Conveyed(log))
     || event(ServerChoosesKEX(cr', sr', KEM_13(BadCiphertext)))
     || event(ServerChoosesHash(cr', sr', WeakHash))
     || event(SentBrokenKEMSecret)
     || event(LeakedEK(pubEK))
.

(* B4 variant — EXPECTED FALSE *)
query log: bitstring, pubEK: pubkey, cr': random, sr': random;
inj-event(Appraised(log))
    ==> inj-event(Conveyed(log))
     || event(ServerChoosesHash(cr', sr', WeakHash))
     || event(LeakedEK(pubEK))
.

(* B5 injective + LeakedAK only — EXPECTED TRUE *)
query log: bitstring, pubAK: pubkey, cr': random, sr': random;
inj-event(Appraised(log))
    ==> inj-event(Conveyed(log))
     || event(ServerChoosesKEX(cr', sr', KEM_13(BadCiphertext)))
     || event(ServerChoosesHash(cr', sr', WeakHash))
     || event(SentBrokenKEMSecret)
     || event(LeakedAK(pubAK))
.

(* B5 variant — EXPECTED TRUE *)
query log: bitstring, pubAK: pubkey, cr': random, sr': random;
inj-event(Appraised(log))
    ==> inj-event(Conveyed(log))
     || event(ServerChoosesHash(cr', sr', WeakHash))
     || event(LeakedAK(pubAK))
.

(* B6 non-injective bare, Level 3 — EXPECTED FALSE*)
query pubEK: pubkey, psk: preSharedKey, cr: random, sr: random,
      offer: params, mode: params,
      kc: ae_key, ks: ae_key, ems: bitstring, rms: bitstring;
event(ClientFinished(pubEK, psk, cr, sr, offer, mode, kc, ks, ems, rms))
    ==> event(PreServerFinished(pubEK, psk, cr, sr, offer, mode, kc, ks, ems))
.

(* B6 variant — EXPECTED FALSE *)
query pubEK: pubkey, psk: preSharedKey, cr: random, sr: random,
      offer: params, mode: params,
      kc: ae_key, ks: ae_key, ems: bitstring, rms: bitstring;
event(ClientFinished(pubEK, psk, cr, sr, offer, mode, kc, ks, ems, rms))
    ==> event(PreServerFinished(pubEK, psk, cr, sr, offer, mode, kc, ks, ems))
.

(* B7 injective + weak-crypto escapes only, Level 3 — EXPECTED FALSE *)
query pubEK: pubkey, psk: preSharedKey, cr: random, sr: random,
      offer: params, mode: params,
      kc: ae_key, ks: ae_key, ems: bitstring, rms: bitstring,
      cr': random, sr': random;
inj-event(ClientFinished(pubEK, psk, cr, sr, offer, mode, kc, ks, ems, rms))
    ==> inj-event(PreServerFinished(pubEK, psk, cr, sr, offer, mode, kc, ks, ems))
     || event(ServerChoosesKEX(cr', sr', KEM_13(BadCiphertext)))
     || event(ServerChoosesHash(cr', sr', WeakHash))
     || event(SentBrokenKEMSecret)
.
