(**********************************************************************)
(* G-TLS1: Server identity binding                                    *)
(*
  If client and server share gxy they must be communicating with
  each other, conditioned on a single identity anchor surviving.
  The falsification boundary confirms two anchors are insufficient
  for unconditional binding; the KEM supplies the third.
*)
(**********************************************************************)

(* Expected true if ideal DHE is hardcoded *)
query idS, idXS:identity, gxy:bitstring;
  event(ServerID(idS, gxy)) &&
  event(ClientID(idXS, gxy)) ==>
  idS = idXS
.

query idS, idXS:identity, gxy:bitstring;
  event(ServerID(idS, gxy))
.

query idS, idXS:identity, gxy:bitstring;
  event(ClientID(idXS, gxy))
.

query idS, idXS:identity, gxy:bitstring;
  event(ServerID(idS, gxy)) &&
  event(ClientID(idXS, gxy))
.

