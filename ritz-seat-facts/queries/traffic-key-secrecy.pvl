(**********************************************************************)
(* Traffic key secrecy                                                *)
(*
  kc is the client application write key. Its secrecy conditioned on
  ClientComp is split into single-key disjuncts.
*)
(**********************************************************************)

query ID_S:identity, pubTIK:pubkey, pubAK:pubkey, pubKEM:pubkey,
      psk:preSharedKey, cr:random, sr:random,
      offer:params, mode:params, dev_state:bitstring,
      kc:ae_key, ks:ae_key, ems:bitstring, rms:bitstring;
  attacker(kc) &&
  event(ClientComp(ID_S, pubTIK, psk, offer, mode, kc, ks, ems, rms, cr, sr, pubKEM, dev_state)) ==>
  event(LeakedTIK(pubTIK))
.

query ID_S:identity, pubTIK:pubkey, pubAK:pubkey, pubKEM:pubkey,
      psk:preSharedKey, cr:random, sr:random,
      offer:params, mode:params, dev_state:bitstring,
      kc:ae_key, ks:ae_key, ems:bitstring, rms:bitstring;
  attacker(kc) &&
  event(ClientComp(ID_S, pubTIK, psk, offer, mode, kc, ks, ems, rms, cr, sr, pubKEM, dev_state)) ==>
  event(LeakedKEM(pubKEM))
.

query ID_S:identity, pubTIK:pubkey, pubAK:pubkey, pubKEM:pubkey,
      psk:preSharedKey, cr:random, sr:random,
      offer:params, mode:params, dev_state:bitstring,
      kc:ae_key, ks:ae_key, ems:bitstring, rms:bitstring;
  attacker(kc) &&
  event(ClientComp(ID_S, pubTIK, psk, offer, mode, kc, ks, ems, rms, cr, sr, pubKEM, dev_state)) ==>
  event(LeakedAK(pubAK))
.

(* Falsification boundary — expected false. *)
query ID_S:identity, pubTIK:pubkey, pubAK:pubkey, pubKEM:pubkey,
      psk:preSharedKey, cr:random, sr:random,
      offer:params, mode:params, dev_state:bitstring,
      kc:ae_key, ks:ae_key, ems:bitstring, rms:bitstring;
  attacker(kc) &&
  event(ClientComp(ID_S, pubTIK, psk, offer, mode, kc, ks, ems, rms, cr, sr, pubKEM, dev_state))
.

(***********************************************************************
 * Traffic key secrecy WithAK: kc secrecy with session-specific AK     *
 * (uses ClientCompWithAK event declared in G-C2)                      *
 ***********************************************************************)

query ID_S:identity, pubTIK:pubkey, pubAK:pubkey, pubKEM:pubkey,
      psk:preSharedKey, cr:random, sr:random,
      offer:params, mode:params, dev_state:bitstring,
      kc:ae_key, ks:ae_key, ems:bitstring, rms:bitstring;
  attacker(kc) &&
  event(ClientCompWithAK(ID_S, pubTIK, pubAK, psk, offer, mode, kc, ks, ems, rms, cr, sr, pubKEM, dev_state)) ==>
  event(LeakedAK(pubAK))
.
