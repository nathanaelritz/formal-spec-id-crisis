(**********************************************************************)
(* G-TLS2a: Aliveness                                                 *)
(*
  The client completing a handshake guarantees the server was alive,
  conditioned on any single key remaining uncompromised.
*)
(**********************************************************************)

query ID_S:identity, pubTIK:pubkey;
  event(ClientFinishedAliveness(ID_S)) ==>
  event(PreServerFinishedAliveness(ID_S)) ||
  event(LeakedTIK(pubTIK))
.

query ID_S:identity, pubKEM:pubkey;
  event(ClientFinishedAliveness(ID_S)) ==>
  event(PreServerFinishedAliveness(ID_S)) ||
  event(LeakedKEM(pubKEM))
.

query ID_S:identity, pubAK:pubkey;
  event(ClientFinishedAliveness(ID_S)) ==>
  event(PreServerFinishedAliveness(ID_S)) ||
  event(LeakedAK(pubAK))
.

(* Falsification boundary — expected false. *)
query ID_S:identity;
  event(ClientFinishedAliveness(ID_S)) ==>
  event(PreServerFinishedAliveness(ID_S))
.

(***********************************************************************
 * G-TLS2a WithAK: Aliveness with session-specific AK binding         *
 ***********************************************************************)

query ID_S:identity, pubAK:pubkey;
  event(ClientFinishedAlivenessWithAK(ID_S, pubAK)) ==>
  event(PreServerFinishedAlivenessWithAK(ID_S, pubAK)) ||
  event(LeakedAK(pubAK))
.

(* G-TLS2a WithAK: falsification boundary — expected false *)
query ID_S:identity, pubAK:pubkey;
  event(ClientFinishedAlivenessWithAK(ID_S, pubAK)) ==>
  event(PreServerFinishedAlivenessWithAK(ID_S, pubAK))
.

(***********************************************************************
 * G-TLS2a WithKEM: Aliveness with session-specific KEM binding       *
 ***********************************************************************)

query ID_S:identity, pubKEM:pubkey;
  event(ClientFinishedAlivenessWithKEM(ID_S, pubKEM)) ==>
  event(PreServerFinishedAlivenessWithKEM(ID_S, pubKEM)) ||
  event(LeakedKEM(pubKEM))
.

(* G-TLS2a WithKEM: falsification boundary — expected false *)
query ID_S:identity, pubKEM:pubkey;
  event(ClientFinishedAlivenessWithKEM(ID_S, pubKEM)) ==>
  event(PreServerFinishedAlivenessWithKEM(ID_S, pubKEM))
.
