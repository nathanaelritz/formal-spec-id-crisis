(**********************************************************************)
(* G-CA1: Compound authentication with full identity                  *)
(*
  Injective agreement over (ID, pubTIK, pubAK, session params).
  Any single anchor is sufficient to preserve compound identity.
*)
(**********************************************************************)

query ID:identity, pubTIK:pubkey, pubAK:pubkey,
      psk:preSharedKey, cr:random, sr:random,
      offer:params, mode:params,
      kc:ae_key, ks:ae_key, ems:bitstring, rms:bitstring;
  inj-event(ClientFinishedWithID(ID, pubTIK, pubAK, psk, cr, sr, offer, mode, kc, ks, ems, rms)) ==>
  inj-event(PreServerFinishedWithID(ID, pubTIK, pubAK, psk, cr, sr, offer, mode, kc, ks, ems)) ||
  event(LeakedTIK(pubTIK))
.

query ID:identity, pubTIK:pubkey, pubAK:pubkey, pubKEM:pubkey,
      psk:preSharedKey, cr:random, sr:random,
      offer:params, mode:params,
      kc:ae_key, ks:ae_key, ems:bitstring, rms:bitstring;
  inj-event(ClientFinishedWithID(ID, pubTIK, pubAK, psk, cr, sr, offer, mode, kc, ks, ems, rms)) ==>
  inj-event(PreServerFinishedWithID(ID, pubTIK, pubAK, psk, cr, sr, offer, mode, kc, ks, ems)) ||
  event(LeakedKEM(pubKEM))
.

query ID:identity, pubTIK:pubkey, pubAK:pubkey,
      psk:preSharedKey, cr:random, sr:random,
      offer:params, mode:params,
      kc:ae_key, ks:ae_key, ems:bitstring, rms:bitstring;
  inj-event(ClientFinishedWithID(ID, pubTIK, pubAK, psk, cr, sr, offer, mode, kc, ks, ems, rms)) ==>
  inj-event(PreServerFinishedWithID(ID, pubTIK, pubAK, psk, cr, sr, offer, mode, kc, ks, ems)) ||
  event(LeakedAK(pubAK))
.

(* Falsification boundary — expected false. *)
query ID:identity, pubTIK:pubkey, pubAK:pubkey,
      psk:preSharedKey, cr:random, sr:random,
      offer:params, mode:params,
      kc:ae_key, ks:ae_key, ems:bitstring, rms:bitstring;
  inj-event(ClientFinishedWithID(ID, pubTIK, pubAK, psk, cr, sr, offer, mode, kc, ks, ems, rms)) ==>
  inj-event(PreServerFinishedWithID(ID, pubTIK, pubAK, psk, cr, sr, offer, mode, kc, ks, ems))
.

(***********************************************************************
 * G-CA1 WithKEM: Compound identity with session-specific KEM          *
 ***********************************************************************)

query ID:identity, pubTIK:pubkey, pubAK:pubkey, pubKEM:pubkey,
      psk:preSharedKey, cr:random, sr:random,
      offer:params, mode:params,
      kc:ae_key, ks:ae_key, ems:bitstring, rms:bitstring;
  inj-event(ClientFinishedWithIDWithKEM(ID, pubTIK, pubAK, pubKEM, psk, cr, sr, offer, mode, kc, ks, ems, rms)) ==>
  inj-event(PreServerFinishedWithIDWithKEM(ID, pubTIK, pubAK, pubKEM, psk, cr, sr, offer, mode, kc, ks, ems)) ||
  event(LeakedKEM(pubKEM))
.

(* G-CA1 WithKEM: falsification boundary — expected false *)
query ID:identity, pubTIK:pubkey, pubAK:pubkey, pubKEM:pubkey,
      psk:preSharedKey, cr:random, sr:random,
      offer:params, mode:params,
      kc:ae_key, ks:ae_key, ems:bitstring, rms:bitstring;
  inj-event(ClientFinishedWithIDWithKEM(ID, pubTIK, pubAK, pubKEM, psk, cr, sr, offer, mode, kc, ks, ems, rms)) ==>
  inj-event(PreServerFinishedWithIDWithKEM(ID, pubTIK, pubAK, pubKEM, psk, cr, sr, offer, mode, kc, ks, ems))
.
